---
import site from '../data/site.json';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

// Drop the real quokka logo into public/ (SVG preferred, or a square PNG at
// 2x the display size) and set `logo` in src/data/site.json to its path,
// e.g. "/logo-quokka.svg". Until then the placeholder mark below is used —
// a blue badge with an orange ring, echoing the event artwork without
// pretending to be the mascot.
const logo = (site as { logo?: string }).logo ?? '';
---

{
  logo ? (
    <img src={logo} alt={`${site.name} logo`} class={className} width="40" height="40" />
  ) : (
    <svg
      class={className}
      viewBox="0 0 40 40"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="20" cy="20" r="19" class="fill-azure-600" />
      <circle cx="20" cy="20" r="17.5" class="stroke-sunset-500" stroke-width="2.5" fill="none" />
      <circle cx="20" cy="20" r="7" class="fill-sunset-500" />
    </svg>
  )
}
