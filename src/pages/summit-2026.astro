---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import MailingList from '../components/MailingList.astro';
import EoiForm from '../components/EoiForm.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import forms from '../data/forms.json';
import site from '../data/site.json';
---

<Base
  title="AI Disrupt Summit 2026"
  description="Join Perth AI's AI Disrupt Summit 2026, a day for AI builders, product and software engineers, founders and enterprise teams. Saturday 12 December at Curtin University, Bentley."
  image="/images/2026/1212-disrupt-summit/disrupt-2026-hero-tile.jpg"
  imageAlt="Pixel-art AI Disrupt Summit 2026 artwork showing the Perth skyline and a quokka mascot."
  imageWidth="1920"
  imageHeight="1080"
>
  <PageHero
    eyebrow="Our signature event"
    title="AI Disrupt Summit 2026"
    lead="A day for people building with AI to share what they're making, learn from each other and meet the people shaping the work. Saturday 12 December, all day at Curtin University, Bentley."
  >
    {/* Option 3: a small card with the brand gradient as its border. The
        gradient does the attention work; the card itself stays quiet. */}
    <a
      href="/summit"
      class="group mt-8 inline-block rounded-2xl bg-linear-to-r from-azure-500 via-orchid-500 to-coral-500 p-0.5 shadow-sm transition-shadow hover:shadow-md"
    >
      <span class="flex items-center gap-4 rounded-[14px] bg-white px-5 py-3">
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-orchid-700">Last year</span>
        <span class="text-sm font-semibold text-ink-900">Revisit AI Disrupt 2025</span>
        <span aria-hidden="true" class="text-orchid-700 transition-transform group-hover:translate-x-1">→</span>
      </span>
    </a>
  </PageHero>

  <nav aria-labelledby="summit-tabs-title" class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <div class="rounded-2xl border border-ink-200 bg-white p-5 shadow-sm sm:p-6">
      <h2
        id="summit-tabs-title"
        class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-ink-600"
      >
        Event information
      </h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          site.summit.tabs.map((tab) => (
            <li>
              {tab.href ? (
                <a
                  href={tab.href}
                  class="inline-block rounded-full bg-sand-200 px-4 py-2 text-sm font-semibold text-ink-800 transition-colors hover:bg-orchid-700 hover:text-white"
                >
                  {tab.label}
                </a>
              ) : (
                <span
                  aria-disabled="true"
                  class="inline-block cursor-not-allowed rounded-full border border-dashed border-ink-200 px-4 py-2 text-sm font-semibold text-ink-400"
                >
                  {tab.label}
                  <span class="sr-only"> (coming soon)</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-xs text-ink-600">Greyed-out sections are coming soon.</p>
    </div>
  </nav>

  <Section class="pt-10 sm:pt-12">
    <figure>
      <img
        src="/images/2026/1212-disrupt-summit/disrupt-2026-hero-tile.jpg"
        alt="Pixel-art AI Disrupt Summit 2026 artwork showing the Perth skyline and a quokka mascot."
        width="1920"
        height="1080"
        class="w-full rounded-3xl object-cover"
        fetchpriority="high"
      />
      <figcaption class="mt-4 text-sm text-ink-600">
        Saturday 12 December 2026, all day. Tim Winton Lecture Theatre, Curtin University, Bentley.
      </figcaption>
    </figure>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="font-display text-2xl font-semibold">For people building what comes next</h2>
        <p class="mt-4 leading-relaxed text-ink-600 text-pretty">
          After the first summit in 2025, AI Disrupt is back for a full day focused on AI
          innovation, engineering and the people building the local ecosystem. Whether you're a
          developer, product or software engineer, founder, investor or working in tech, there's
          something for everyone. We're expecting around 300 people to join us to compare notes
          and see what's being built.
        </p>
        <p class="mt-4 leading-relaxed text-ink-600 text-pretty">
          The program will span three parts of the community:
        </p>
        <ul class="mt-5 space-y-3">
          <li class="rounded-xl bg-sand-100 px-5 py-4">
            <h3 class="font-display font-semibold">Builders and start-ups</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-600">
              People turning ideas into products, projects and companies.
            </p>
          </li>
          <li class="rounded-xl bg-sand-100 px-5 py-4">
            <h3 class="font-display font-semibold">Product and engineering</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-600">
              The teams designing, building and shipping AI-powered products.
            </p>
          </li>
          <li class="rounded-xl bg-sand-100 px-5 py-4">
            <h3 class="font-display font-semibold">AI-first enterprise</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-600">
              Practitioners bringing AI from experiments into real organisations.
            </p>
          </li>
        </ul>
      </div>
      <div class="rounded-2xl border border-ink-200 p-7">
        <h3 class="font-display text-lg font-semibold">In short</h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="text-ink-500">When</dt>
            <dd class="font-medium">{site.summit.when}</dd>
          </div>
          <div>
            <dt class="text-ink-500">Where</dt>
            <dd class="font-medium">Curtin University, Bentley</dd>
          </div>
          <div>
            <dt class="text-ink-500">Main talks</dt>
            <dd class="font-medium">
              Two tracks in rooms 213.101 and 213.104, Tim Winton Lecture Theatre
            </dd>
            <dd class="mt-2">
              <Button href="https://campusmap.curtin.edu.au/bentley/?poi=1000462346" variant="ghost">
                Map of Tim Winton
                <Icon name="arrow" class="h-4 w-4" />
              </Button>
            </dd>
          </div>
          <div>
            <dt class="text-ink-500">Start-up expo, hackathon and workshops</dt>
            <dd class="font-medium">TL Robertson Library, Building 105 Level 4 (TBC)</dd>
            <dd class="mt-2">
              <Button href="https://campusmap.curtin.edu.au/bentley/?poi=1000462610" variant="ghost">
                Map of the Library
                <Icon name="arrow" class="h-4 w-4" />
              </Button>
            </dd>
          </div>
          <div>
            <dt class="text-ink-500">Who it's for</dt>
            <dd class="font-medium">Anyone building with AI, at any level</dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={site.summit.registrationUrl}>
            Register on Luma
            <Icon name="arrow" class="h-4 w-4" />
          </Button>
          <Button href="#booth" variant="ghost">
            Ask for a start-up booth
          </Button>
          <Button href="#speak" variant="ghost">
            Speak at a future event
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="muted" eyebrow="The day" title="What to expect">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <li class="rounded-2xl bg-white p-7">
        <h3 class="font-display text-lg font-semibold text-orchid-700"><span aria-hidden="true">🎤</span> Two track speaker series</h3>
        <p class="mt-2 leading-relaxed text-ink-600">
          Technical AI, founder journeys, emerging trends and the choices involved in building and
          investing in AI.
        </p>
      </li>
      <li class="rounded-2xl bg-white p-7">
        <h3 class="font-display text-lg font-semibold text-orchid-700"><span aria-hidden="true">⚡</span> Lightning talks</h3>
        <p class="mt-2 leading-relaxed text-ink-600">
          Two parallel sessions of lightning talks, PechaKucha style. Short, sharp and on to the
          next one.
        </p>
      </li>
      <li class="rounded-2xl bg-white p-7">
        <h3 class="font-display text-lg font-semibold text-orchid-700"><span aria-hidden="true">🛠️</span> Workshops</h3>
        <p class="mt-2 leading-relaxed text-ink-600">
          Practical sessions for people who want to build, test and deploy AI for real.
        </p>
      </li>
      <li class="rounded-2xl bg-white p-7">
        <h3 class="font-display text-lg font-semibold text-orchid-700"><span aria-hidden="true">🚀</span> Start-up expo</h3>
        <p class="mt-2 leading-relaxed text-ink-600">
          A look at growth-stage start-ups from Perth and the wider Australian AI ecosystem.
        </p>
      </li>
      <li class="rounded-2xl bg-white p-7">
        <h3 class="font-display text-lg font-semibold text-orchid-700"><span aria-hidden="true">🥊</span> AI start-up battle</h3>
        <p class="mt-2 leading-relaxed text-ink-600">
          Twelve of Perth's best early-stage start-ups battle it out. Cast your vote and the top 3 pitch
          at the end of the day to win glory.
        </p>
      </li>
      <li class="rounded-2xl bg-white p-7">
        <h3 class="font-display text-lg font-semibold text-orchid-700"><span aria-hidden="true">💻</span> Hackathon</h3>
        <p class="mt-2 leading-relaxed text-ink-600">
          Team up to turn an idea into an AI prototype, then share what you build.
        </p>
      </li>
      <li class="rounded-2xl bg-white p-7">
        <h3 class="font-display text-lg font-semibold text-orchid-700"><span aria-hidden="true">🤝</span> Networking</h3>
        <p class="mt-2 leading-relaxed text-ink-600">
          Meet builders, peers and investors over food, drinks and conversations between sessions.
        </p>
      </li>
      <li class="rounded-2xl bg-white p-7">
        <h3 class="font-display text-lg font-semibold text-orchid-700"><span aria-hidden="true">☕</span> Get to Know You Coffee</h3>
        <p class="mt-2 leading-relaxed text-ink-600">
          Hosted by Jia. Grab a coffee at La Vita Cafe, north of campus, before the event starts and
          meet a few friendly faces. This optional event is at your own cost.
        </p>
      </li>
      <li class="rounded-2xl bg-white p-7 sm:col-span-2 lg:col-span-1">
        <h3 class="font-display text-lg font-semibold text-orchid-700"><span aria-hidden="true">🌇</span> Sundowner</h3>
        <p class="mt-2 leading-relaxed text-ink-600">
          Round out the day at nearby Varsity Waterford with drinks and networking with friends. This
          optional event is at your own cost.
        </p>
      </li>
    </ul>
  </Section>

  <Section id="booth" eyebrow="Expression of interest" title={forms.booth.title} lead={forms.booth.intro}>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div class="space-y-5 leading-relaxed text-ink-700">
        <p>
          A booth is the easiest way to get honest feedback in a day. People stop, try the thing
          and ask the awkward questions. If you can, bring a demo people can try, not just a banner.
        </p>
        <p>
          This is an expression of interest, not a booking. Let us know whether you're growth stage
          or early stage so we can get a good mix on the floor, and we'll come back to you once we
          know how it fits together.
        </p>
        <p>
          Perth AI is run by volunteers, and donations and prizes help make the day happen. If you
          can chip in, great. If you can't, still put your hand up.
        </p>
      </div>

      <div class="rounded-2xl border border-ink-200 bg-white p-7">
        <EoiForm
          id="booth-form"
          action={forms.booth.action}
          accessKey={forms.booth.accessKey}
          subject="AI Disrupt 2026 — booth expression of interest"
          submitLabel="Put us down for a booth"
          fields={[
            { name: 'name', label: 'Your name', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'startup', label: 'Start-up name', required: true },
            {
              name: 'stage',
              label: 'What stage are you at?',
              type: 'select',
              required: true,
              options: ['Growth stage', 'Early stage'],
            },
            {
              name: 'showing',
              label: 'What would you show?',
              type: 'textarea',
              required: true,
              placeholder: 'What you do, and what people could see or try at your booth.',
            },
            {
              name: 'ai_part',
              label: 'What is the AI part of your product or demo?',
              type: 'textarea',
            },
            {
              name: 'contribution',
              label: 'Able to contribute a donation or prize?',
              type: 'select',
              options: ['Yes, a donation', 'Yes, a prize', 'Yes, both', 'Not this time'],
            },
            {
              name: 'contribution_details',
              label: 'What could you contribute? (optional)',
              placeholder: 'Vouchers, Lego, a merch pack, a dollar amount…',
            },
            { name: 'website', label: 'Website (optional)' },
            { name: 'linkedin', label: 'LinkedIn (optional)' },
          ]}
        />
      </div>
    </div>
  </Section>

  <Section id="speak" tone="muted" eyebrow="Speakers and demos" title={forms.speaker.title} lead={forms.speaker.intro}>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div class="space-y-5 leading-relaxed text-ink-700">
        <p>
          A talk, a five-minute lightning talk, a live demo, a hands-on workshop or a spot on a
          panel. If you've shipped it, broken it or studied it, there's probably a slot that fits.
        </p>
        <p>
          You don't need a polished abstract. Tell us the idea and who it's for, and we'll help shape
          it with you. First-time speakers are welcome, and so are people who'd rather start small
          before taking a big stage.
        </p>
        <p>
          We read every submission and get in touch when a future event has a slot that fits.
        </p>
        <p>
          Want a look back at last year's event? <a
            href="/summit"
            class="font-medium text-orchid-700 underline decoration-orchid-700/40 underline-offset-2 hover:decoration-orchid-700"
            >See the AI Disrupt Summit 2025 recap</a
          >.
        </p>
      </div>

      <div class="rounded-2xl border border-ink-200 bg-white p-7">
        <EoiForm
          id="speaker-form"
          action={forms.speaker.action}
          accessKey={forms.speaker.accessKey}
          subject="Perth AI — speaker submission (future event)"
          submitLabel="Submit my idea"
          fields={[
            { name: 'name', label: 'Your name', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'talk', label: 'Talk or demo title', required: true },
            {
              name: 'abstract',
              label: "What's it about?",
              type: 'textarea',
              required: true,
              placeholder: 'What will people learn or see, and who is it for?',
            },
            { name: 'format', label: 'Format', type: 'select', options: ['Talk', 'Lightning talk', 'Demo', 'Workshop', 'Panel'] },
            { name: 'link', label: 'LinkedIn or website (optional)' },
          ]}
        />
      </div>
    </div>
  </Section>

  <Section>
    <div class="rounded-2xl border border-ink-200 p-8 sm:p-10">
      <h2 class="font-display text-2xl font-semibold">A couple of things to know</h2>
      <ul class="mt-4 list-inside list-disc space-y-2 leading-relaxed text-ink-600">
        <li>Bring your laptop, charger and a water bottle.</li>
        <li>Photos and videos will be taken at the event.</li>
      </ul>
      <p class="mt-5 leading-relaxed text-ink-600">
        Subscribe below for event updates and registration details.
      </p>
    </div>
  </Section>

  <Section class="pt-0">
    <MailingList />
  </Section>
</Base>
