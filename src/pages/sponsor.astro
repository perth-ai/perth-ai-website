---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import EoiForm from '../components/EoiForm.astro';
import sponsors from '../data/sponsors.json';
import forms from '../data/forms.json';
import site from '../data/site.json';
---

<Base
  title="Sponsor"
  description="Sponsor Perth AI — keep community events free for builders, students and people between roles, and get in front of the people building with AI in Western Australia."
>
  <PageHero
    eyebrow="Sponsorship"
    title="Back the room where it happens"
    lead="Perth AI is free to attend and run entirely by volunteers. Sponsorship is what keeps it that way — and what lets us do the ambitious stuff."
  />

  <Section>
    <div class="grid gap-6 md:grid-cols-3">
      {
        [
          {
            title: 'It keeps events free',
            body: 'Students, career-changers and people between roles are exactly who we want in the room. A ticket price quietly removes them.',
          },
          {
            title: 'You meet builders, not a list',
            body: "You're in the room with people actually shipping AI work in WA — hiring, partnering and learning happen sideways over a drink.",
          },
          {
            title: 'It stays honest',
            body: "Sponsors get thanked properly and get to speak on substance. Nobody buys a pitch slot; the community can smell it and it doesn't work.",
          },
        ].map((item) => (
          <div class="rounded-2xl border-t-4 border-t-sunset-500 border border-ink-100 bg-white p-7 shadow-sm">
            <h2 class="font-display text-lg font-semibold">{item.title}</h2>
            <p class="mt-3 leading-relaxed text-ink-600">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    tone="muted"
    eyebrow="Tiers"
    title="Ways to support us"
    lead="These are starting points, not a rate card. If something else suits you better, say so — in-kind support is just as welcome as cash."
  >
    <div class="grid gap-6 lg:grid-cols-2 xl:grid-cols-4">
      {
        sponsors.tiers.map((tier) => (
          <article
            class:list={[
              'flex flex-col rounded-2xl bg-white p-7',
              tier.featured ? 'ring-2 ring-sunset-500' : 'ring-1 ring-ink-200',
            ]}
          >
            {tier.featured && (
              <span class="mb-3 w-fit rounded-full bg-sunset-500 px-3 py-1 text-xs font-semibold text-ink-950">
                Most popular
              </span>
            )}
            <h3 class="font-display text-xl font-semibold">{tier.name}</h3>
            <p class="mt-1 text-sm font-medium text-sunset-700">{tier.price}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{tier.summary}</p>
            <ul class="mt-5 flex-1 space-y-2.5 text-sm text-ink-700">
              {tier.includes.map((item) => (
                <li class="flex gap-2.5">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-azure-500" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  {
    sponsors.current.length > 0 && (
      <Section eyebrow="Thank you" title="Our current sponsors">
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {sponsors.current.map((sponsor: any) => (
            <li class="rounded-2xl border border-ink-200 p-6 text-center">
              <a href={sponsor.url} rel="noopener" class="font-display font-semibold hover:text-sunset-700">
                {sponsor.name}
              </a>
              {sponsor.tier && <p class="mt-1 text-xs text-ink-400">{sponsor.tier}</p>}
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section id="enquire" eyebrow="Next step" title="Let's talk">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div class="space-y-5 text-ink-700">
        <p class="leading-relaxed">
          Fill this in, or just email <a
            href={`mailto:${site.email}`}
            class="font-medium text-sunset-700 hover:underline">{site.email}</a
          > directly. An organiser will get back to you — we're volunteers, so give us a few days.
        </p>
        <p class="leading-relaxed">
          Not sure sponsorship is the right fit? Hosting an event in your office costs you nothing
          and helps just as much.
        </p>
        <Button href="/get-involved#space" variant="ghost">Offer a space instead</Button>
      </div>

      <div class="rounded-2xl border border-ink-200 bg-white p-7">
        <EoiForm
          id="sponsor-page-form"
          action={forms.sponsor.action}
          subject="Perth AI — sponsorship enquiry"
          submitLabel="Send enquiry"
          fields={[
            { name: 'name', label: 'Your name', required: true },
            { name: 'organisation', label: 'Organisation', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'tier', label: 'Interested in', type: 'select', options: [...sponsors.tiers.map((t) => t.name), 'Something else'] },
            { name: 'detail', label: 'Anything else?', type: 'textarea', placeholder: 'What you\'re hoping to get out of it, budget, timing…' },
          ]}
        />
      </div>
    </div>
  </Section>
</Base>
