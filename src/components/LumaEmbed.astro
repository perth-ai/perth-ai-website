---
import site from '../data/site.json';
import Button from './Button.astro';

// Set `links.lumaEmbedId` in src/data/site.json. Find it in Luma under
// Calendar → Settings → Embed. Once set, upcoming events appear here
// automatically — no code changes needed when you add an event.
//
// You can paste either form and both work:
//   - the bare calendar ID, e.g. "cal-AbC123"
//   - the full iframe src from Luma's embed snippet, e.g.
//     "https://luma.com/embed/calendar/cal-AbC123/events"
//
// Taking the full URL matters because Luma is migrating lu.ma → luma.com and
// has changed this path before. Pasting their snippet verbatim always wins
// over us reconstructing the URL from an ID.
interface Props {
  height?: number;
}
const { height = 560 } = Astro.props;

const configured = site.links.lumaEmbedId.trim();
const embedSrc = configured.startsWith('http')
  ? configured
  : configured
    ? `https://luma.com/embed/calendar/${configured}/events`
    : '';
---

{
  embedSrc ? (
    <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-sm">
      <iframe
        src={embedSrc}
        title="Upcoming Perth AI events"
        width="100%"
        height={height}
        style="border: none;"
        allowfullscreen
        aria-hidden="false"
        tabindex="0"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="rounded-2xl border border-dashed border-ink-200 bg-white p-10 text-center">
      <h3 class="font-display text-xl font-semibold">Events live on Luma</h3>
      <p class="mx-auto mt-3 max-w-md text-ink-600">
        Every Perth AI event — meet-ups, co-building sessions, workshops and the rest — is listed
        and ticketed on our Luma calendar. Subscribe there and you'll hear about each one as it
        goes up.
      </p>
      <Button href={site.links.luma} class="mt-6">
        View the Luma calendar
      </Button>
    </div>
  )
}
