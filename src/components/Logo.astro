---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<!-- Sunset over water. Swap this file to change the mark everywhere. -->
<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="20" cy="17" r="11" class="fill-sunset-500" />
  <rect x="2" y="24" width="36" height="2.5" rx="1.25" class="fill-river-400" />
  <rect x="7" y="30" width="26" height="2.5" rx="1.25" class="fill-river-400/60" />
</svg>
