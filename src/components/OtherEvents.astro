---
import otherEvents from '../data/otherEvents.json';

// Filter out anything that's already happened, then sort soonest first.
const today = new Date().toISOString().slice(0, 10);
const upcoming = otherEvents.events
  .filter((event) => event.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-AU', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
  });
---

{
  upcoming.length > 0 ? (
    <ul class="grid gap-4 sm:grid-cols-2">
      {upcoming.map((event) => (
        <li class="rounded-2xl border border-ink-200 bg-white p-6 transition-colors hover:border-ink-400">
          <p class="text-xs font-semibold uppercase tracking-wider text-river-600">
            {formatDate(event.date)} · {event.location}
          </p>
          <h3 class="mt-2 font-display text-lg font-semibold">
            <a href={event.url} rel="noopener" class="hover:text-sunset-600">
              {event.title}
            </a>
          </h3>
          <p class="mt-1 text-sm text-ink-400">by {event.host}</p>
          {event.blurb && <p class="mt-3 text-sm leading-relaxed text-ink-600">{event.blurb}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="rounded-2xl border border-dashed border-ink-200 bg-white p-8 text-center text-ink-600">
      Nothing listed right now. Running an AI event in Perth? We'll happily promote it —{' '}
      <a href="/get-involved#event-idea" class="font-medium text-sunset-600 hover:underline">
        send it through
      </a>
      .
    </p>
  )
}
