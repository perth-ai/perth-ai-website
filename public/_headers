# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The DDD Perth 2026 booth kiosk is for the booth, not for search results,
# whatever ALLOW_INDEXING says for the rest of the site. See docs/ddd-2026.md.
/ddd-2026/*
  X-Robots-Tag: noindex, nofollow

# The AI Disrupt 2026 info pack is unlisted: shared by direct link only, never in
# search results. It's a hand-made HTML file in public/summit-2026/info/.
# Scoped to /info so the public /summit-2026 page stays indexable.
# Don't add it to robots.txt — a Disallow line would advertise the URL.
/summit-2026/info
  X-Robots-Tag: noindex, nofollow
/summit-2026/info/*
  X-Robots-Tag: noindex, nofollow

# The kiosk's service worker: always check for a new one, so a fix (or the
# off switch) reaches booth devices on their next load.
/ddd-2026/sw.js
  Cache-Control: no-cache
