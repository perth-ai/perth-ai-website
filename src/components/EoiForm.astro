---
import site from '../data/site.json';

interface Field {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'textarea' | 'select' | 'checkboxes';
  required?: boolean;
  placeholder?: string;
  options?: string[];
}

interface Props {
  id: string;
  action: string;
  accessKey?: string;
  subject: string;
  fields: Field[];
  submitLabel?: string;
}

const { id, action, accessKey = '', subject, fields, submitLabel = 'Send' } = Astro.props;

// A form only posts for real once it has both an endpoint and a real access
// key. Until then it falls back to the visitor's mail client, so a half-wired
// form can't quietly swallow submissions. See src/data/forms.json.
const isWired = Boolean(action) && Boolean(accessKey) && !accessKey.startsWith('PASTE_');
const usesMailto = !isWired;
const formAction = isWired ? action : `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;

// Web3Forms wants an absolute redirect, so it comes from the site config:
// localhost in dev, the .pages.dev URL on previews, the real domain once
// SITE_URL is set (see astro.config.mjs). Without it the visitor would land on
// Web3Forms' own thank-you page instead of ours.
const thanksUrl = Astro.site ? new URL('/thanks', Astro.site).href : undefined;

const inputClass =
  'mt-1.5 w-full rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 text-sm text-ink-900 placeholder:text-ink-400 focus:border-sunset-500 focus:outline-none focus:ring-1 focus:ring-sunset-500';
---

<form
  id={id}
  action={formAction}
  method="post"
  enctype={usesMailto ? 'text/plain' : undefined}
  class="space-y-4"
>
  {
    isWired && (
      <>
        {/* Web3Forms' reserved fields. The access key is public by design —
            it identifies the destination inbox, it isn't a secret. Reply-to is
            picked up automatically from the field named "email". */}
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value={subject} />
        <input type="hidden" name="from_name" value={site.name} />
        {thanksUrl && <input type="hidden" name="redirect" value={thanksUrl} />}
      </>
    )
  }

  {/* Honeypot: bots tick it, humans never see it. Web3Forms rejects any
      submission where "botcheck" is set. */}
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" aria-hidden="true" />

  {
    fields.map((field) =>
      field.type === 'checkboxes' ? (
        <fieldset>
          <legend class="block text-sm font-medium text-ink-800">
            {field.label}
            {field.required && <span class="text-sunset-700"> *</span>}
          </legend>
          <div class="mt-2 space-y-2">
            {(field.options ?? []).map((option, index) => (
              <label class="flex items-center gap-2.5 text-sm text-ink-700">
                <input
                  id={`${id}-${field.name}-${index}`}
                  name={field.name}
                  type="checkbox"
                  value={option}
                  class="h-4 w-4 rounded border-ink-300 text-sunset-500 focus:ring-sunset-500"
                />
                {option}
              </label>
            ))}
          </div>
        </fieldset>
      ) : (
        <div>
          <label for={`${id}-${field.name}`} class="block text-sm font-medium text-ink-800">
            {field.label}
            {field.required && <span class="text-sunset-700"> *</span>}
          </label>

          {field.type === 'textarea' ? (
            <textarea
              id={`${id}-${field.name}`}
              name={field.name}
              rows="4"
              required={field.required}
              placeholder={field.placeholder}
              class={inputClass}
            />
          ) : field.type === 'select' ? (
            <select id={`${id}-${field.name}`} name={field.name} required={field.required} class={inputClass}>
              <option value="">Choose one…</option>
              {(field.options ?? []).map((option) => (
                <option value={option}>{option}</option>
              ))}
            </select>
          ) : (
            <input
              id={`${id}-${field.name}`}
              name={field.name}
              type={field.type ?? 'text'}
              required={field.required}
              placeholder={field.placeholder}
              class={inputClass}
            />
          )}
        </div>
      )
    )
  }

  <button
    type="submit"
    class="inline-flex w-full items-center justify-center rounded-xl bg-sunset-500 px-5 py-3 text-sm font-semibold text-ink-950 transition-colors hover:bg-sunset-600 sm:w-auto"
  >
    {submitLabel}
  </button>

  <p class="text-xs text-ink-400">
    {
      usesMailto
        ? `This opens your email app addressed to ${site.email}.`
        : 'We only use your details to reply. No lists, no sharing.'
    }
  </p>
</form>
