---
import site from '../data/site.json';

interface Props {
  /** Extra classes for the image. */
  class?: string;
  /** Full horizontal lockup (default) or the icon mark on its own. */
  variant?: 'lockup' | 'mark';
}

const { class: className = '', variant = 'lockup' } = Astro.props;

// Both assets are the designers' own artwork, cropped to their content box and
// resized for the web. The lockup is the "White Cyan Transparent" horizontal
// secondary logo, which the style guide names for website headers.
//
// IMPORTANT: both are the white-on-dark colourway, so they only work on the
// navy. If a light-background header ever appears, use the Mono or
// BlackandWhite logo from docs/branding/ instead of recolouring these.
const assets = {
  lockup: { src: '/perth-ai-lockup.webp', width: 512, height: 160, class: 'h-9 w-auto' },
  mark: { src: '/perth-ai-mark.webp', width: 256, height: 256, class: 'h-9 w-9' },
};
const a = assets[variant];
---

<img
  src={a.src}
  alt={site.name}
  width={a.width}
  height={a.height}
  class:list={[a.class, 'shrink-0', className]}
  loading="eager"
  decoding="async"
/>
