---
import site from '../data/site.json';

interface Props {
  /** Extra classes for the mark itself. */
  class?: string;
  /** Show the "PERTH AI" wordmark beside the mark. Off for tight spaces. */
  withWordmark?: boolean;
  /** Wordmark colour. `dark` = navy text for light backgrounds. */
  tone?: 'light' | 'dark';
}

const { class: className = '', withWordmark = true, tone = 'light' } = Astro.props;

// The branding pack ships PNGs only, so the header lockup is rebuilt here:
// the icon/avatar mark (cropped from Secondary Logo.png) plus live text in
// Space Grotesk. That keeps the wordmark crisp at any size and lets it flip
// colour for dark and light backgrounds — the supplied horizontal lockup is a
// flat PNG with a baked white background and can do neither.
// Swap in the lockup as a single <img> if the designers send a vector.
const mark = (site as { logo?: string }).logo ?? '/perth-ai-mark.webp';
---

<span class="flex shrink-0 items-center gap-2.5">
  <img
    src={mark}
    alt=""
    aria-hidden="true"
    width="36"
    height="36"
    class:list={['h-9 w-9 shrink-0', className]}
    loading="eager"
    decoding="async"
  />
  {
    withWordmark && (
      <span
        class:list={[
          'font-display text-lg font-bold tracking-tight',
          tone === 'dark' ? 'text-ink-900' : 'text-white',
        ]}
      >
        PERTH <span class={tone === 'dark' ? 'text-azure-700' : 'text-azure-400'}>AI</span>
      </span>
    )
  }
</span>
