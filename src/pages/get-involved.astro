---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import EoiForm from '../components/EoiForm.astro';
import MailingList from '../components/MailingList.astro';
import forms from '../data/forms.json';
import eventTypes from '../data/eventTypes.json';
---

<Base
  title="Get involved"
  description="Propose a new event or mini group, offer a venue, or support Perth AI."
>
  <PageHero
    eyebrow="Get involved"
    title="This only works because people put their hand up"
    lead="Hosting, suggesting, organising — pick whichever one you can actually see yourself doing. Want to speak at an event instead? Email us."
  />

  {/* Event ideas */}
  <Section
    id="event-idea"
    tone="muted"
    eyebrow="Expression of interest"
    title={forms.eventIdea.title}
    lead={forms.eventIdea.intro}
  >
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="leading-relaxed text-ink-700">
          Some of the best things we run started as someone saying "I wish there was a…". If enough
          people want the same thing, we'll find a room and a date.
        </p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            eventTypes.map((type) => (
              <li class="rounded-xl bg-white px-4 py-3 text-sm font-medium">{type.name}</li>
            ))
          }
          <li class="rounded-xl bg-white px-4 py-3 text-sm font-medium text-ink-400">
            Something else entirely
          </li>
        </ul>
      </div>

      <div class="rounded-2xl border border-ink-200 bg-white p-7">
        <EoiForm
          id="event-idea-form"
          action={forms.eventIdea.action}
          subject="Perth AI — event idea"
          submitLabel="Send the idea"
          fields={[
            { name: 'name', label: 'Your name', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'format', label: 'What kind of thing?', type: 'select', options: [...eventTypes.map((t) => t.name), 'Mini group / recurring', 'Something else'] },
            { name: 'idea', label: 'Tell us about it', type: 'textarea', required: true, placeholder: 'What is it, who is it for, and would you help run it?' },
            { name: 'help', label: 'Would you help organise it?', type: 'select', options: ['Yes, happy to help run it', 'Maybe, depending on time', 'No — just want it to exist'] },
          ]}
        />
      </div>
    </div>
  </Section>

  {/* Space / sponsorship */}
  <Section
    id="space"
    eyebrow="Venues & support"
    title={forms.sponsor.title}
    lead={forms.sponsor.intro}
  >
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div class="space-y-5 text-ink-700">
        <p class="leading-relaxed">
          Venue is our single biggest constraint. If your office has a space that fits 30–60 people
          on a weeknight and sits empty after six, you can single-handedly unblock a month of
          events — and get a room full of the exact people you're probably trying to hire.
        </p>
        <p class="leading-relaxed">
          Paid sponsorship keeps events free, covers food and drinks, and lets us put on the bigger
          things like the Summit. Full detail on what that looks like is on the{' '}
          <a href="/sponsor" class="font-medium text-sunset-700 hover:underline">sponsorship page</a>.
        </p>
      </div>

      <div class="rounded-2xl border border-ink-200 bg-white p-7">
        <EoiForm
          id="sponsor-form"
          action={forms.sponsor.action}
          subject="Perth AI — sponsorship or venue"
          submitLabel="Start the conversation"
          fields={[
            { name: 'name', label: 'Your name', required: true },
            { name: 'organisation', label: 'Organisation', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'offering', label: 'What can you offer? (choose all that apply)', type: 'checkboxes', options: ['A venue', 'Paid sponsorship', 'Food and drinks', 'Prizes, hardware or credits', 'Not sure yet — let\'s talk'] },
            { name: 'detail', label: 'Any detail that helps', type: 'textarea', placeholder: 'Capacity, availability, budget, what you\'d want out of it…' },
          ]}
        />
      </div>
    </div>
  </Section>

  <Section class="pt-0">
    <MailingList />
  </Section>
</Base>
