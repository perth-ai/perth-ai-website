---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import LumaEmbed from '../components/LumaEmbed.astro';
import MailingList from '../components/MailingList.astro';
import site from '../data/site.json';
import segments from '../data/segments.json';
import eventTypes from '../data/eventTypes.json';

const accentRing = {
  sunset: 'border-t-sunset-500',
  azure: 'border-t-azure-500',
  ink: 'border-t-ink-600',
};
---

<Base>
  {/* Hero — carries the coral-to-azure gradient from the event artwork.
       Kept dark underneath so white text stays legible over every stop. */}
  <div class="relative overflow-hidden bg-ink-950">
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-coral-500 via-azure-600 to-azure-700 opacity-90"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-32 -top-40 h-[32rem] w-[32rem] rounded-full bg-sunset-500/35 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-56 -left-40 h-[30rem] w-[30rem] rounded-full bg-coral-500/40 blur-3xl"
      aria-hidden="true"
    >
    </div>
    {/* Darkens the lower half so the body copy and buttons keep contrast */}
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/70 via-ink-950/20 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sunbeam-400">
        Perth, Western Australia
      </p>
      <h1
        class="mt-5 max-w-3xl font-display text-4xl font-semibold leading-[1.08] text-white sm:text-6xl"
      >
        The people building with AI in Perth, in one room.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/90 text-pretty">
        Meet-ups, co-building sessions, workshops and the odd cafe catch-up or night at the pub.
        Free, give-first, and run by volunteers — no pitches, just people building things and
        helping each other do it.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <Button href="/events" variant="primary">
          See what's on
          <Icon name="arrow" class="h-4 w-4" />
        </Button>
        <Button href="/get-involved" variant="onDark">Get involved</Button>
      </div>
    </div>
  </div>

  {/* Who it's for */}
  <Section
    eyebrow="Who it's for"
    title="Multiple groups, one community"
    lead="The problems look different depending on where you sit, so we run things for all of them — and put them in the same room on purpose."
  >
    <div class="grid gap-6 lg:grid-cols-3">
      {
        segments.map((segment) => (
          <article
            class:list={[
              'flex flex-col rounded-2xl border border-ink-100 border-t-4 bg-white p-7 shadow-sm',
              accentRing[segment.accent as keyof typeof accentRing],
            ]}
          >
            <h3 class="font-display text-xl font-semibold">{segment.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-600">{segment.summary}</p>
            <ul class="mt-5 space-y-2.5 text-sm text-ink-700">
              {segment.points.map((point) => (
                <li class="flex gap-2.5">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-sunset-500" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  {/* Upcoming events */}
  <Section
    id="events"
    tone="muted"
    eyebrow="What's on"
    title="Upcoming events"
    lead="Everything runs through Luma. Subscribe there and new events land in your calendar as we announce them."
  >
    <LumaEmbed />

    <h3 class="mt-14 font-display text-xl font-semibold">The kinds of things we run</h3>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        eventTypes.map((type) => (
          <li class="rounded-2xl bg-white p-6">
            <Icon name={type.icon} class="h-6 w-6 text-sunset-500" />
            <h4 class="mt-4 font-display text-base font-semibold">{type.name}</h4>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{type.description}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* Flagship event */}
  <Section>
    <div
      class="grid items-center gap-10 rounded-3xl bg-ink-900 px-8 py-12 sm:px-12 lg:grid-cols-[1.5fr_1fr]"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-azure-300">
          Our flagship event
        </p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-white sm:text-4xl">
          {site.summit.name}
        </h2>
        <p class="mt-4 max-w-lg leading-relaxed text-ink-200/85 text-pretty">
          {site.summit.blurb} A full day of talks, demos and hard questions about what AI actually changes
          — for the people building it and the organisations trying to adopt it.
        </p>
      </div>
      <div class="lg:justify-self-end">
        <p class="text-sm text-ink-400">{site.summit.when}</p>
        <Button href={site.summit.url} variant="onDark" class="mt-3">
          Summit site
          <Icon name="arrow" class="h-4 w-4" />
        </Button>
      </div>
    </div>
  </Section>

  {/* Get involved */}
  <Section
    eyebrow="Get involved"
    title="There's more than one way in"
    lead="This runs on people putting their hand up. Any of these would genuinely help."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            title: 'Suggest an event',
            body: 'Want a dreamers session, a study group, a regular co-build? Tell us.',
            href: '/get-involved#event-idea',
          },
          {
            title: 'Offer a space',
            body: 'Got a room that fits 40 people on a weeknight? That solves our biggest constraint.',
            href: '/get-involved#space',
          },
          {
            title: 'Sponsor',
            body: 'Keep events free for everyone.',
            href: '/sponsor',
          },
        ].map((card) => (
          <a
            href={card.href}
            class="group flex flex-col rounded-2xl border border-ink-200 p-6 transition-colors hover:border-sunset-500 hover:bg-sunset-100/40"
          >
            <h3 class="font-display text-lg font-semibold">{card.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{card.body}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-sunset-700">
              Start here
              <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  {/* Join the conversation */}
  <Section
    eyebrow="Stay in the loop"
    title="Join the conversation"
    lead="Slack is where the day-to-day chat, job leads and event planning actually happen."
  >
    <div class="flex flex-col items-start gap-4 rounded-2xl border border-ink-200 bg-white p-7 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-ink-600">
        Events, general chat, AI education and learning, and (soon) a jobs channel.
      </p>
      {
        site.links.slack ? (
          <Button href={site.links.slack} variant="primary">
            Join our Slack
          </Button>
        ) : (
          <Button href={`mailto:${site.email}?subject=Slack%20invite`} variant="primary">
            Ask for a Slack invite
          </Button>
        )
      }
    </div>
  </Section>

  {/* Mailing list */}
  <Section class="pt-0">
    <MailingList />
  </Section>
</Base>
