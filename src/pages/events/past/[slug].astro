---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import pastEvents from '../../../data/pastEvents.json';
import summitGalleries from '../../../data/summitGalleries.json';

export function getStaticPaths() {
  return pastEvents.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const artworks =
  event.artworks ?? (event.artwork ? [{ src: event.artwork, alt: event.artworkAlt }] : []);
const photos =
  event.gallery ??
  event.galleryGroups?.flatMap((gallery) =>
    summitGalleries[gallery].map((filename) => `/images/2025/2025-12-summit/${gallery}/${filename}`),
  ) ??
  [];
---

<Base title={event.title} description={event.summary} image={event.image} imageAlt={event.imageAlt}>
  <PageHero
    eyebrow={`2026 Events | ${event.date}`}
    title={event.title}
    lead={event.summary}
  />

  <Section>
    <a href="/events/past" class="text-sm font-semibold text-sunset-700 hover:underline">
      &larr; All community events
    </a>

    <img
      src={event.image}
      alt={event.imageAlt}
      class="mt-8 w-full rounded-lg"
      fetchpriority="high"
      decoding="async"
    />

    <div class="mt-8 max-w-3xl">
        <p class="text-sm font-medium text-sunset-700">
          <time datetime={event.dateTime}>{event.date}</time>
        </p>
        {event.venue && (
          <p class="mt-2 leading-relaxed text-ink-600">
            At {event.venueUrl ? (
              <a
                href={event.venueUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-ink-900 underline decoration-sunset-500 underline-offset-4"
                >{event.venue}</a
              >
            ) : (
              event.venue
            )}{event.location ? ` in ${event.location}` : ''}.
          </p>
        )}
        {event.articleTitle && (
          <h2 class="mt-8 font-display text-xl font-semibold text-ink-900">{event.articleTitle}</h2>
        )}
        {event.description && (
          <p class="mt-4 leading-relaxed text-ink-600">{event.description}</p>
        )}

        {event.sections?.map((section) => (
          <section class="mt-8">
            {section.title && (
              <h2 class="font-display text-xl font-semibold text-ink-900">{section.title}</h2>
            )}
            {section.paragraphs?.map((paragraph) => (
              <p class="mt-3 leading-relaxed text-ink-600">
                {paragraph.map((segment) =>
                  typeof segment === 'string' ? (
                    segment
                  ) : segment.url ? (
                    <a
                      href={segment.url}
                      target={segment.url.startsWith('/') ? undefined : '_blank'}
                      rel={segment.url.startsWith('/') ? undefined : 'noopener noreferrer'}
                      class="font-medium text-ink-900 underline decoration-sunset-500 underline-offset-4"
                    >
                      {segment.bold ? <strong>{segment.text}</strong> : segment.text}
                    </a>
                  ) : segment.bold ? (
                    <strong>{segment.text}</strong>
                  ) : (
                    segment.text
                  ),
                )}
              </p>
            ))}
            {'items' in section && section.items && (
              <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-ink-600">
                {section.items.map((item) => (
                  <li class={typeof item[0] === 'string' && item[0].startsWith('🔹') ? 'list-none' : ''}>
                    {item.map((segment) =>
                      typeof segment === 'string' ? (
                        segment
                      ) : segment.url ? (
                        <a
                          href={segment.url}
                          target={segment.url.startsWith('/') ? undefined : '_blank'}
                          rel={segment.url.startsWith('/') ? undefined : 'noopener noreferrer'}
                          class="font-medium text-ink-900 underline decoration-sunset-500 underline-offset-4"
                        >
                          {segment.bold ? <strong>{segment.text}</strong> : segment.text}
                        </a>
                      ) : segment.bold ? (
                        <strong>{segment.text}</strong>
                      ) : (
                        segment.text
                      ),
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}

        {artworks.length > 0 && (
          <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {artworks.map((artwork) => (
              <li>
                <img
                  src={artwork.src}
                  alt={artwork.alt}
                  class="w-full rounded-lg"
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        )}
    </div>

    {photos.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-2xl font-semibold text-ink-900">{event.galleryTitle ?? 'Photos'}</h2>
        <p class="mt-2 text-sm text-ink-600">{photos.length} photos</p>
        <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {photos.map((photo) => (
            <li>
              <img
                src={photo}
                alt={`Photo from ${event.title}.`}
                class="aspect-[4/3] w-full rounded-lg object-cover"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </div>
    )}
  </Section>
</Base>